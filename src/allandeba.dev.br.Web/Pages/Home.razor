@layout HomeLayout
@page "/"
@using allandeba.dev.br.Core.Common.Constants
@using allandeba.dev.br.Core.Models.Github
@using allandeba.dev.br.Core.Requests.Github
@using allandeba.dev.br.Web.Common.Enums
@using allandeba.dev.br.Web.Components.Home
@using allandeba.dev.br.Web.Localization
@using allandeba.dev.br.Web.Services
@using System.Diagnostics
@using System.Reflection

@inject IGithubHandler GithubHandler
@inject IJSRuntime JS
@inject LanguageService LanguageService
@inject IContentProvider Site
@inject EventAggregator EventAggregator
@implements IAsyncDisposable

<PageTitle>@Site.Content.Meta.Title</PageTitle>

<LoaderSection />
<HomeNavMenu />

<HeroSection />
<AboutSection />
<ExperienceSection />
<ProjectsSection Projects="_githubProjects" HasError="_hasError" />
<ContactSection />

<StatusBar />

@code {
    private List<GithubProject>? _githubProjects;
    private bool _hasError;
    private IJSObjectReference? _animModule;
    private string? _projectsLoadResult;
    private long _projectsLoadDurationMs;
    private bool _projectsLoadReported;

    protected override void OnInitialized()
    {
        LanguageService.Init();
        EventAggregator.Subscribe<ELanguageType>(OnLanguageChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var timer = Stopwatch.StartNew();
        try
        {
            var request = new GetGithubProjectRequest { User = OwnersInfo.GithubUser };
            var response = await GithubHandler.GetFavoriteProjectsAsync(request);
            if (response.IsSuccess && response.Data?.GithubProjects is { } projects)
                _githubProjects = projects;
            else
                _hasError = true;
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _projectsLoadDurationMs = timer.ElapsedMilliseconds;
            _projectsLoadResult = _hasError ? "error" : _githubProjects?.Count > 0 ? "success" : "empty";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Home.razor.js");
            await _animModule.InvokeVoidAsync("setBodyClass", "home-page", true);
            var version = typeof(App).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
            await _animModule.InvokeVoidAsync("init", version);
            await JS.InvokeVoidAsync("setMetaDescription", Site.Content.Meta.Description);
        }
        if (_animModule is not null && _projectsLoadResult is not null && !_projectsLoadReported)
        {
            _projectsLoadReported = true;
            await _animModule.InvokeVoidAsync("trackProjectsLoad", _projectsLoadResult,
                _githubProjects?.Count ?? 0, _projectsLoadDurationMs);
        }
    }

    private async void OnLanguageChanged(ELanguageType language)
    {
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("setMetaDescription", Site.Content.Meta.Description);
        if (_animModule is not null)
            await _animModule.InvokeVoidAsync("refreshSection");
    }

    public async ValueTask DisposeAsync()
    {
        EventAggregator.Unsubscribe<ELanguageType>(OnLanguageChanged);
        try
        {
            if (_animModule is not null)
            {
                await _animModule.InvokeVoidAsync("dispose");
                await _animModule.InvokeVoidAsync("setBodyClass", "home-page", false);
            }
        }
        catch (JSDisconnectedException) { }
        if (_animModule is not null)
            await _animModule.DisposeAsync();
    }
}
