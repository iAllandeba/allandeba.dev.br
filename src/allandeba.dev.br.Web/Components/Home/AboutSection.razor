@using allandeba.dev.br.Web.Localization
@inherits LocalizedComponentBase
@inject IContentProvider Site

<section id="about" class="terminal-section section-reveal" data-section="about" data-label="@Site.Content.StatusBar.About" aria-label="Sobre mim">
    <div class="terminal-section-inner">
        <div class="prompt-line anim">
            <span class="p-user">allandeba</span><span class="p-at">&#64;</span><span class="p-host">dev</span><span
            class="p-colon">:</span><span class="p-path">@Site.Content.About.Path</span><span class="p-sym">&nbsp;$&nbsp;</span><span
            class="p-cmd">cat </span><span class="p-arg">@Site.Content.About.Cmd</span>
        </div>

        <div class="about-grid">
            <div class="about-left">
                <h2 class="about-subhead anim">@Site.Content.About.HeadBio</h2>
                <p class="about-p anim">
                    @((MarkupString)Site.Content.About.BioHtml)
                </p>

                <h2 class="about-subhead anim">@Site.Content.About.HeadStack</h2>
                <p class="about-p anim">
                    @((MarkupString)Site.Content.About.StackHtml)
                </p>
                <p class="about-p anim">
                    @((MarkupString)Site.Content.About.ServerHtml)
                </p>

            </div>

            <div class="about-metrics">
                <div class="metric anim-x">
                    <div class="metric-number">5+</div>
                    <div class="metric-label">@Site.Content.About.MetricLabel</div>
                    <div class="metric-divider"></div>
                </div>
            </div>
        </div>
    </div>
</section>
