@using allandeba.dev.br.Web.Localization
@inherits LocalizedComponentBase
@inject IContentProvider Site

<section id="hero" class="hero-section section-reveal" data-section="hero" data-label="@Site.Content.StatusBar.Hero" aria-labelledby="hero-name">
    <div id="hero-glow"></div>
    <div class="terminal-block">
        <div class="prompt-line">
            <span class="p-user">allandeba</span><span class="p-at">&#64;</span><span class="p-host">dev</span><span
            class="p-colon">:</span><span class="p-path">@Site.Content.Hero.Path</span><span
            class="p-sym">&nbsp;$&nbsp;</span><span class="p-cmd">@foreach (var c in Site.Content.Hero.Cmd) {
            <span class="char">@c</span>
        }
    </span>
</div>


<h1 id="hero-name" class="hero-name">
    Allan <span class="gold">Debastiani</span>
</h1>

<p class="hero-role">@Site.Content.Hero.Role</p>

<p class="hero-value">
    @((MarkupString)Site.Content.Hero.ValueHtml)
</p>

<p class="hero-proof">@((MarkupString)Site.Content.Hero.ProofHtml)</p>

<div class="hero-buttons">
    <a href="mailto:allandeba@icloud.com" class="btn-t primary" data-contact-channel="email" data-contact-placement="hero">@Site.Content.Hero.BtnContact</a>
    <a href="https://www.linkedin.com/in/allan-debastiani/" target="_blank" rel="noopener noreferrer" class="btn-t" data-contact-channel="linkedin" data-contact-placement="hero">[ LinkedIn ↗ ]</a>
    <a href="#projects" class="btn-t">@Site.Content.Hero.BtnProjects</a>
</div>

<div class="hero-tech">
    @foreach (var tech in _techStack)
    {
        <span class="hero-tech-badge @(tech.Hi ? "hi" : "")">@tech.Name</span>
    }
</div>

</div>
</section>


@code {
    private record TechBadge(string Name, bool Hi = false);

    private readonly TechBadge[] _techStack =
    {
        new("C#", Hi: true),
        new("ASP.NET Core", Hi: true),
        new("REST APIs", Hi: true),
        new("EF Core"),
        new("SQL Server"),
        new("PostgreSQL"),
        new("Docker"),
        new("Blazor"),
    };
}
