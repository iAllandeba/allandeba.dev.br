@using allandeba.dev.br.Web.Localization
@inherits LocalizedComponentBase
@inject IJSRuntime JS
@inject IContentProvider Site
@implements IAsyncDisposable

<section id="contact" class="terminal-section section-reveal" data-section="contact" data-label="@Site.Content.StatusBar.Contact" aria-label="@Site.Content.Nav.Contact">
    <div class="terminal-section-inner">
        <div class="prompt-line anim">
            <span class="p-user">allandeba</span><span class="p-at">&#64;</span><span class="p-host">dev</span><span
            class="p-colon">:</span><span class="p-path">@Site.Content.Contact.Path</span><span
            class="p-sym">&nbsp;$&nbsp;</span><span class="p-cmd">@Site.Content.Contact.Cmd</span>
        </div>

        <div class="ct-output">
            <p class="ct-intro">@Site.Content.Contact.Intro</p>
            <div class="ct-actions">
                <a href="mailto:allandeba@icloud.com" class="btn-t primary" data-contact-channel="email" data-contact-placement="contact">@Site.Content.Contact.EmailButton</a>
                <a href="https://www.linkedin.com/in/allan-debastiani/" target="_blank" rel="noopener noreferrer" class="btn-t" data-contact-channel="linkedin" data-contact-placement="contact">@Site.Content.Contact.LinkedInButton</a>
                <button type="button" id="chat-btn" class="btn-t" @onclick="OpenContact">@Site.Content.Contact.Button</button>
            </div>
            <p class="ct-email">allandeba&#64;icloud.com</p>
            <a href="https://github.com/allandeba" target="_blank" rel="noopener noreferrer" class="ct-github">GitHub ↗</a>
        </div>
    </div>
</section>

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Home/ContactSection.razor.js");
    }

    private async Task OpenContact()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("openContact");
    }

    public async ValueTask DisposeAsync()
    {
        // Base.Dispose handles language unsubscribe; this only owns the JS module.
        Dispose();
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
