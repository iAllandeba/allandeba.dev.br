@using allandeba.dev.br.Web.Localization
@inherits LocalizedComponentBase
@inject IContentProvider Site

<section id="experience" class="terminal-section section-reveal" data-section="experience" data-label="@Site.Content.StatusBar.Experience" aria-label="Experiência">
    <div class="terminal-section-inner">
        <div class="prompt-line anim">
            <span class="p-user">allandeba</span><span class="p-at">&#64;</span><span class="p-host">dev</span><span
            class="p-colon">:</span><span class="p-path">@Site.Content.Experience.Path</span><span
            class="p-sym">&nbsp;$&nbsp;</span><span class="p-cmd">cat </span><span
            class="p-arg">@Site.Content.Experience.Cmd</span>
        </div>

        @foreach (var job in Site.Content.Experience.Jobs)
        {
            <div class="exp-entry anim">
                <div class="exp-header">
                    <div>
                        <div class="exp-company">@job.Company</div>
                        <div class="exp-role">@job.Role</div>
                    </div>
                    <div class="exp-period">@job.Period</div>
                </div>
                <div class="exp-context">@job.Context</div>
                <ul class="exp-bullets">
                    @foreach (var bullet in job.BulletsHtml)
                    {
                        <li><span>@((MarkupString)bullet)</span></li>
                    }
                </ul>
                <div class="exp-tags">
                    @foreach (var tag in job.Tags)
                    {
                        <span class="exp-tag">@tag</span>
                    }
                </div>
            </div>
        }
    </div>
</section>
